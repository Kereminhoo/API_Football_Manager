@page
@model FootManager.Pages.Matchs.CreateModel

<div class="container">
    <h2>Encoder un nouveau match</h2>

    <form method="post" class="mt-4">
        <div class="mb-3">
            <label class="form-label">Date du match</label>
            <input asp-for="NouveauMatch.DateMatch" class="form-control" type="datetime-local" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Équipe Domicile</label>
                <select asp-for="NouveauMatch.EquipeDomicileId" asp-items="Model.ListeEquipes" class="form-select">
                    <option value="">-- Choisir --</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Équipe Extérieur</label>
                <select asp-for="NouveauMatch.EquipeExterieurId" asp-items="Model.ListeEquipes" class="form-select">
                    <option value="">-- Choisir --</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Score Domicile</label>
                <input asp-for="NouveauMatch.ScoreDomicile" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Score Extérieur</label>
                <input asp-for="NouveauMatch.ScoreExterieur" class="form-control" type="number" min="0" />
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Enregistrer le match</button>
            <a asp-page="/Matchs/Index" class="btn btn-secondary">Retour</a>
        </div>
    </form>
</div>
@page
@model FootManager.Pages.Matchs.CreateModel
@{
    ViewData["Title"] = "Encoder un match";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h2 class="mb-0">Encoder un nouveau match</h2>
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label font-weight-bold">Date du match</label>
                        <input asp-for="NouveauMatch.DateMatch" class="form-control" type="datetime-local" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Équipe Domicile</label>
                        <select asp-for="NouveauMatch.EquipeDomicileId" asp-items="Model.ListeEquipes" class="form-select">
                            <option value="">-- Sélectionner --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Équipe Extérieur</label>
                        <select asp-for="NouveauMatch.EquipeExterieurId" asp-items="Model.ListeEquipes" class="form-select">
                            <option value="">-- Sélectionner --</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Score Domicile</label>
                        <input asp-for="NouveauMatch.ScoreDomicile" class="form-control" type="number" min="0" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Score Extérieur</label>
                        <input asp-for="NouveauMatch.ScoreExterieur" class="form-control" type="number" min="0" />
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-page="/Matchs/Index" class="btn btn-secondary">Annuler</a>
                    <button type="submit" class="btn btn-success">Enregistrer le résultat</button>
                </div>
            </form>
        </div>
    </div>
</div>
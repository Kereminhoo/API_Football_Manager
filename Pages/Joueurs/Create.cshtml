@page
@model FootManager.Pages.Joueurs.CreateModel
@{
    ViewData["Title"] = "Nouvelle Recrue";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 card shadow p-4">
            <h2 class="text-danger mb-4">Ajouter une recrue</h2>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Nom</label>
                    <input asp-for="NouveauJoueur.Nom" class="form-control" placeholder="Nom du joueur" />
                    <span asp-validation-for="NouveauJoueur.Nom" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Prénom</label>
                    <input asp-for="NouveauJoueur.Prenom" class="form-control" placeholder="Prénom du joueur" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Poste</label>
                    <select asp-for="NouveauJoueur.Poste" class="form-select">
                        <option value="Gardien">Gardien</option>
                        <option value="Défenseur">Défenseur</option>
                        <option value="Milieu">Milieu</option>
                        <option value="Attaquant">Attaquant</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Numéro de maillot</label>
                    <input asp-for="NouveauJoueur.Numero" class="form-control" type="number" min="1" max="99" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Équipe</label>
                    <select asp-for="NouveauJoueur.EquipeId" asp-items="Model.ListeEquipes" class="form-select">
                        <option value="">-- Sélectionner le club --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-page="/Index" class="btn btn-secondary">Annuler</a>
                    <button type="submit" class="btn btn-success">Enregistrer le joueur</button>
                </div>
            </form>
        </div>
    </div>
</div>
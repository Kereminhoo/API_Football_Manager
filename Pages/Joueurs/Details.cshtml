@page "{id:int}"
@model FootManager.Pages.Joueurs.Details
@{
    ViewData["Title"] = "Fiche Joueur - Galatasaray";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0 text-warning">Fiche Technique</h3>
                    <span class="badge bg-danger fs-5">#@Model.Joueur.Numero</span>
                </div>
                
                <div class="card-body bg-light">
                    <div class="text-center mb-4">
                        <h2 class="card-title text-danger fw-bold mt-2">
                            @Model.Joueur.Prenom @Model.Joueur.Nom
                        </h2>
                        <span class="badge bg-secondary fs-6 py-2 px-3 mt-1">
                            @Model.Joueur.Poste
                        </span>
                    </div>
                    
                    <hr class="border-secondary" />
                    
                    <h5 class="text-dark fw-bold mb-3">Détails d'affiliation</h5>
                    <ul class="list-group shadow-sm rounded">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Club actuel :</strong>
                            <span class="text-danger fw-bold">@Model.Joueur.NomEquipe</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Ville :</strong>
                            <span class="text-muted">@Model.Joueur.VilleEquipe</span>
                        </li>
                    </ul>
                </div>
                
                <div class="card-footer d-flex justify-content-between bg-white border-top-0 py-3">
                    
                    <button onclick="history.back()" class="btn btn-secondary">
                        Retour à l'effectif
                    </button>

                   
                    @if (User.IsInRole("Admin")) {
                        <a asp-page="/Joueurs/Edit" asp-route-id="@Model.Joueur.Id" class="btn btn-warning text-white fw-bold">
                            Modifier le profil
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
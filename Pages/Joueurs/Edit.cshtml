@page "{id:int}"
@model FootManager.Pages.Joueurs.Edit
@{
    ViewData["Title"] = "Modifier le joueur";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 card shadow p-4 border-warning">
            <h2 class="mb-4">Modifier : @Model.Joueur.Prenom @Model.Joueur.Nom</h2>

            <form method="post">
                
                <input type="hidden" asp-for="Joueur.Id" />

                <div class="mb-3">
                    <label class="form-label">Nom</label>
                    <input asp-for="Joueur.Nom" class="form-control" />
                    <span asp-validation-for="Joueur.Nom" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Prénom</label>
                    <input asp-for="Joueur.Prenom" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Poste</label>
                    <select asp-for="Joueur.Poste" class="form-select">
                        <option value="Gardien">Gardien</option>
                        <option value="Défenseur">Défenseur</option>
                        <option value="Milieu">Milieu</option>
                        <option value="Attaquant">Attaquant</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Numéro de maillot</label>
                    <input asp-for="Joueur.Numero" class="form-control" type="number" min="1" max="99" />
                    <span asp-validation-for="Joueur.Numero" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Équipe</label>
                    <select asp-for="Joueur.EquipeId" asp-items="Model.ListeEquipes" class="form-select"></select>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-page="/Index" class="btn btn-secondary">Annuler</a>
                    <button type="submit" class="btn btn-warning">Enregistrer les modifications</button>
                </div>
            </form>
        </div>
    </div>
</div>
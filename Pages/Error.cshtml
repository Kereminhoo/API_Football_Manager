@page "{statusCode:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.ErrorTitle;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            
            <div class="display-1 fw-bold text-danger mb-2">
                @Model.StatusCode
            </div>
            
            <h2 class="text-dark fw-bold mb-3">@Model.ErrorTitle</h2>
            
            <p class="text-muted fs-5 mb-4">
                @Model.ErrorMessage
            </p>

            <div class="p-3 bg-light border rounded mb-4 shadow-sm text-start">
                <p class="mb-1 text-muted small">
                    <strong>Note du Staff :</strong> Si ce problème persiste lors de la gestion de l'effectif de Galatasaray, veuillez contacter le support technique.
                </p>
                @if (Model.ShowRequestId)
                {
                    <span class="text-xs text-monospace text-secondary small">ID de suivi : <code>@Model.RequestId</code></span>
                }
            </div>

            
            <a asp-page="/Index" class="btn btn-danger px-4 py-2 shadow-sm">
                Retourner à l'Effectif
            </a>
        </div>
    </div>
</div>
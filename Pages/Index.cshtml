@page
@model IndexModel
@{
    ViewData["Title"] = "Effectif Galatasaray";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Effectif du club</h1>
    <a asp-page="/Joueurs/Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> + Ajouter un joueur
    </a>
</div>

<table class="table table-striped shadow-sm">
    <thead class="table-dark">
    <tr>
        <th>Prénom</th>
        <th>Nom</th>
        <th>Poste</th>
        <th>Numéro</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var joueur in Model.Joueurs) {
        <tr>
            <td>@joueur.Prenom</td>
            <td>@joueur.Nom</td>
            <td>@joueur.Poste</td>
            <td>@joueur.Numero</td>
        </tr>
    }
    </tbody>
</table>
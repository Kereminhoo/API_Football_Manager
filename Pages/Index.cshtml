@page
@model IndexModel
@{
    ViewData["Title"] = "Liste des joueurs";
}

<h1>Effectif du club</h1>

<table class="table">
    <thead>
    <tr>
        <th>Prénom</th>
        <th>Nom</th>
        <th>Poste</th>
        <th>Numéro</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var joueur in Model.Joueurs) {
        <tr>
            <td>@joueur.Prenom</td>
            <td>@joueur.Nom</td>
            <td>@joueur.Poste</td>
            <td>@joueur.Numero</td>
        </tr>
    }
    </tbody>
</table>